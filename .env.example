# Environment Configuration Template
# Copy this file to .env and update values for your environment
# Do NOT commit .env with actual secrets!

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Server URL for shortened URL generation
# Used to construct the full short URL (e.g., https://short.example.com/{code})
SERVER_URL=localhost:8080

# Gin Framework Mode
# Options: debug, release, test
# - debug: Includes full logging and stack traces
# - release: Production mode with minimal logging
# - test: Testing mode
GIN_MODE=debug

# Logging Level
# Options: debug, info, warn, error
LOG_LEVEL=info
